# CivicAI Environment Variables

# Database
MONGODB_URI=mongodb://localhost:27017/civicai
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/civicai

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here-generate-with-openssl-rand-base64-32

# AI Services
# Alibaba Cloud DashScope (Qwen) — powers AI complaint analysis via qwen-vl-max / qwen-plus
# Get your key at https://bailian.console.aliyun.com/ (OpenAI-compatible endpoint)
# Leave empty to run in local fallback mode (deterministic keyword-based analysis)
DASHSCOPE_API_KEY=

# Google Cloud Vision (for image analysis)
GOOGLE_CLOUD_VISION_API_KEY=...

# Azure Speech Services (for voice)
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# Google Cloud Speech-to-Text
GOOGLE_CLOUD_SPEECH_API_KEY=...

# AWS
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# File Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# Email (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=...
EMAIL_FROM=noreply@civicai.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=...

# Push Notifications
WEB_PUSH_PUBLIC_KEY=...
WEB_PUSH_PRIVATE_KEY=...

# External APIs
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_VOICE_INPUT=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false